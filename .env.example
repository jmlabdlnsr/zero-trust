# Template konfigurasi Zero Trust Security.
HOST=127.0.0.1
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002

# Database SQLite lokal.
DB_PATH=./data/zero-trust.sqlite

# Setup mengganti placeholder ini dengan secret acak yang kuat.
# JWT_SECRET digunakan untuk access token user dan service.
JWT_SECRET=GENERATE_WITH_NPM_RUN_SETUP
GATEWAY_SECRET=GENERATE_WITH_NPM_RUN_SETUP
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=GENERATE_WITH_NPM_RUN_SETUP

# Ganti keenam placeholder dengan password yang Anda tentukan sebelum seed pertama.
# Setiap password minimal 12 karakter; seed menyimpan hash-nya di database.
SEED_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_ADMIN_MINIMAL_12_KARAKTER
SEED_DOSEN01_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_DOSEN01_MINIMAL_12_KARAKTER
SEED_DOSEN02_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_DOSEN02_MINIMAL_12_KARAKTER
SEED_MHS01_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_MHS01_MINIMAL_12_KARAKTER
SEED_MHS02_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_MHS02_MINIMAL_12_KARAKTER
SEED_MHS03_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_MHS03_MINIMAL_12_KARAKTER

# Jam edit/finalisasi nilai: waktu mulai inklusif, waktu akhir eksklusif.
ACCESS_START=07:00
ACCESS_END=21:00
ACCESS_TIMEZONE=Asia/Jakarta

# Batas waktu request internal antar-service, dalam milidetik.
REQUEST_TIMEOUT_MS=5000
